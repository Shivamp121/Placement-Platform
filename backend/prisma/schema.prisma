generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  role             Role
  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  jobs             Job[]
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  firstName      String
  lastName       String
  college        String
  degree         String
  branch         String
  graduationYear Int
  githubUrl      String?
  linkedinUrl    String?
  skills         String[]
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model Company {
  id          String             @id @default(uuid())
  name        String
  website     String?
  industry    String?
  description String?
  size        Int?
  logoUrl     String?
  recruiters  RecruiterProfile[]
  jobs        Job[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RecruiterProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  designation String
  companies   Company[]
  user        User      @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

model Job {
  id           String    @id @default(uuid())
  title        String
  description  String    @db.Text
  requirements String[]
  salaryRange  String?
  location     String
  jobType      JobType   @default(FULL_TIME)
  status       JobStatus @default(OPEN)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterId  String
  recruiter    User      @relation(fields: [recruiterId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
